# Copy this file to .env and fill in your key. Never commit .env (it's in .gitignore).

# Your Anthropic API key, from https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Models. The cheap one does the bulk work (updating summaries, facts and notes, checking memory, grading);
# the strong one writes the answers you compare.
MDUEL_WORK_MODEL=claude-haiku-5-5
MDUEL_ANSWER_MODEL=claude-sonnet-5-5

# Prices in US dollars per million tokens, used for the cost meter and estimates only.
# Check https://www.anthropic.com/pricing and update if they've changed.
MDUEL_WORK_PRICE_IN=0.10
MDUEL_WORK_PRICE_OUT=0.50
MDUEL_ANSWER_PRICE_IN=2.00
MDUEL_ANSWER_PRICE_OUT=10.00

# Safety stop: a run halts if it spends more than this many dollars. A full run of all six is about $3.
MDUEL_MAX_RUN_DOLLARS=6.00

# Contestant settings
# Sliding window size, in sessions (you can also change it on the Duel page)
MDUEL_WINDOW_SESSIONS=3
# Rolling summary length cap, in words
MDUEL_SUMMARY_WORDS=200
# Self-editing notes length cap, in words
MDUEL_NOTES_WORDS=400
# How many past messages RAG sends with each answer
MDUEL_RAG_TOP_K=4

# Embeddings for RAG: auto (fastembed if installed, else word matching), fastembed, or tfidf
MDUEL_EMBED_BACKEND=auto

MDUEL_PORT=8010
